# MongoDB (same cluster the Impiseo app uses)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
# Production DB used by the live dashboard (impiseo.vercel.app).
# Local dev uses MONGO_DB=impiseo.
MONGO_DB=impiseo_prod

# Google OAuth — same credentials the app was authorized with, needed to
# refresh the stored googleRefreshToken into an access token.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# HTTP listening options
PORT=3777
# Optional: trust a single secret for the whole server (imp_ keys are per-user
# and resolved from the DB; this is only a convenience override for local dev).
# MCP_API_KEY=

# PostHog — only used if a user has a connected PostHog account (for the
# tracking-gap recommendation). Optional.
# POSTHOG_HOST=https://us.posthog.com

# PageSpeed Insights + CrUX API key — required by run_page_audit (live
# Lighthouse run). Create one key in GCP and enable the PageSpeed Insights API.
# GOOGLE_API_KEY=xxxx